LABDOCS_APP_NAME=labdocs
LABDOCS_ENVIRONMENT=development
LABDOCS_LOG_LEVEL=info
LABDOCS_DATABASE_URL=postgresql+asyncpg://labdocs:labdocs@localhost:5432/labdocs
LABDOCS_UPLOAD_DIR=data/uploads
LABDOCS_MAX_UPLOAD_BYTES=26214400
LABDOCS_CHUNK_MAX_TOKENS=500
LABDOCS_CHUNK_OVERLAP_TOKENS=80
LABDOCS_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LABDOCS_EMBEDDING_DIMENSION=384
LABDOCS_EMBEDDING_BATCH_SIZE=32
LABDOCS_VECTOR_BACKEND=pgvector
LABDOCS_QDRANT_URL=http://localhost:6333
LABDOCS_QDRANT_COLLECTION=labdocs_chunks
LABDOCS_QDRANT_API_KEY=
LABDOCS_QDRANT_TIMEOUT_SECONDS=10

# Default local development target: Ollama's OpenAI-compatible endpoint.
LABDOCS_LLM_PROVIDER=openai_compatible
LABDOCS_LLM_MODEL=qwen2.5:7b
LABDOCS_LLM_BASE_URL=http://localhost:11434/v1
LABDOCS_LLM_API_KEY=
LABDOCS_LLM_TIMEOUT_SECONDS=60
LABDOCS_LLM_MAX_RETRIES=2
LABDOCS_LLM_TEMPERATURE=0
LABDOCS_LLM_MAX_TOKENS=1024

# Anthropic (set LABDOCS_LLM_PROVIDER=anthropic).
LABDOCS_ANTHROPIC_API_KEY=
LABDOCS_ANTHROPIC_BASE_URL=https://api.anthropic.com
LABDOCS_ANTHROPIC_VERSION=2023-06-01

# Azure OpenAI (set LABDOCS_LLM_PROVIDER=azure_openai).
LABDOCS_AZURE_OPENAI_ENDPOINT=
LABDOCS_AZURE_OPENAI_API_KEY=
LABDOCS_AZURE_OPENAI_DEPLOYMENT=
LABDOCS_AZURE_OPENAI_API_VERSION=2024-10-21

LABDOCS_RAG_TOP_K=8
LABDOCS_ABSTENTION_THRESHOLD=0.75

# Bounded agent loop. AGENT_MAX_STEPS is hard-capped at 5.
LABDOCS_AGENT_MAX_STEPS=5
LABDOCS_AGENT_STEP_TIMEOUT_SECONDS=20
LABDOCS_AGENT_TOTAL_TIMEOUT_SECONDS=60
LABDOCS_AGENT_MAX_TOOL_OUTPUT_CHARS=8000
LABDOCS_AGENT_MAX_METADATA_ROWS=50
