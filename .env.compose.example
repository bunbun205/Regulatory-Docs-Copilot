# Copy to .env.compose; pass --env-file .env.compose to Docker Compose.
# Keep the real file private. These examples make no claims of live provider validation.
POSTGRES_USER=labdocs
POSTGRES_DB=labdocs
# Generate a unique URL-safe password, e.g. openssl rand -hex 24.
POSTGRES_PASSWORD=replace-with-a-unique-hex-password
WEB_PORT=3000
LABDOCS_ENVIRONMENT=production
LABDOCS_VECTOR_BACKEND=both
LABDOCS_LLM_PROVIDER=openai_compatible
# Groq; choose a model currently enabled on your account.
LABDOCS_LLM_BASE_URL=https://api.groq.com/openai/v1
LABDOCS_LLM_MODEL=openai/gpt-oss-20b
LABDOCS_LLM_API_KEY=replace-with-your-provider-key
LABDOCS_LLM_REASONING_EFFORT=low
LABDOCS_LLM_TIMEOUT_SECONDS=60
LABDOCS_LLM_MAX_RETRIES=2
LABDOCS_LLM_MAX_TOKENS=4096
LABDOCS_GAPCHECK_JUDGE_MAX_TOKENS=2048
# Gemini alternative: replace the three URL/model/key values above.
# LABDOCS_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LABDOCS_LLM_MODEL=gemini-3.8-flash
# LABDOCS_LLM_API_KEY=your-gemini-key
# Optional local Ollama: enable --profile ollama; remove reasoning effort if unsupported.
# LABDOCS_LLM_BASE_URL=http://ollama:11434/v1
# LABDOCS_LLM_MODEL=qwen2.5:7b
# LABDOCS_LLM_API_KEY=ollama
# LABDOCS_ENVIRONMENT=development
